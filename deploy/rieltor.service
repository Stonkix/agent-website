# /etc/systemd/system/rieltor.service
[Unit]
Description=Rieltor site (FastAPI)
After=network.target

[Service]
User=rieltor
Group=rieltor
WorkingDirectory=/srv/rieltor
ExecStart=/srv/rieltor/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

# Минимальная изоляция: писать можно только в БД и фото
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/rieltor/data /srv/rieltor/media

[Install]
WantedBy=multi-user.target
